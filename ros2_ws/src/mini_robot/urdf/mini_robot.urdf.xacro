<?xml version="1.0"?>
<!-- Two-wheel differential drive base: one driven wheel per side on the
     transverse axis, plus a passive caster for the third contact point.
     The LiDAR points along the caster end, so THAT end is the robot's front
     and +x runs towards it: the caster leads and the drive axle trails. The
     Arduino uses the same convention (WHEEL_Y_SIGN and the sign constants in
     MiniRobotGeometry.h), so nothing rotates anything on the way across the
     serial link and this file simply describes the robot as it is.
     Dimensions are nominal; the ones that actually matter to the software are
     'track' (must match TRACK_WIDTH_MM in the sketch) and 'wheel_radius'
     (must match WHEEL_DIAMETER_MM / 2). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mini_robot">
  <xacro:property name="base_length" value="0.18"/>
  <xacro:property name="base_width" value="0.16"/>
  <xacro:property name="base_height" value="0.06"/>
  <xacro:property name="wheel_radius" value="0.0235"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <!-- Left-to-right wheel contact patch distance: TRACK_WIDTH_MM / 1000. -->
  <xacro:property name="track" value="0.20"/>
  <!-- The drive axle IS the origin. The Arduino integrates odometry from the
       mean of the two wheel distances - i.e. the drive-axle midpoint - and the
       serial bridge publishes exactly that as odom -> base_footprint. Any
       offset here would put the model's centre of rotation somewhere the
       odometry is not, which mis-places the laser whenever the robot turns. -->
  <xacro:property name="axle_x" value="0.0"/>
  <!-- Passive trolley caster, on the centreline, 100 mm ahead of the drive
       axle: it is the leading end, under the LiDAR. -->
  <xacro:property name="caster_x" value="0.10"/>
  <xacro:property name="caster_radius" value="0.015"/>
  <!-- COIN-D6 sits directly above the caster, 100 mm above the ground. -->
  <xacro:property name="laser_height" value="0.10"/>
  <!-- Body box is nominal/visual only; offset forward so it spans axle to caster. -->
  <xacro:property name="body_x" value="0.035"/>

  <material name="body"><color rgba="0.15 0.35 0.65 1"/></material>
  <material name="wheel"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="sensor"><color rgba="0.2 0.8 0.2 1"/></material>

  <!-- base_footprint is the ground-projected frame Nav2, AMCL and SLAM use. -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="${body_x} 0 ${base_height/2}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry><material name="body"/></visual>
    <collision><origin xyz="${body_x} 0 ${base_height/2}"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry></collision>
    <inertial><origin xyz="${body_x} 0 ${base_height/2}"/><mass value="2.0"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.012"/></inertial>
  </link>

  <!-- Wheel joint names must match the /joint_states the serial bridge
       publishes. The bridge maps motor number to joint name with its
       wheel_joint_names parameter (base.yaml), which is where the fact that
       motor 1 drives the -y wheel and motor 2 the +y one is written down on
       the ROS side. -->
  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel_link">
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel"/></visual>
      <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="0.12"/><inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.0002"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${axle_x} ${y} 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left" y="${track/2}"/>
  <xacro:wheel name="right" y="${-track/2}"/>

  <!-- Passive caster: fixed joint because nothing publishes a state for it,
       and its swivel does not affect any transform the stack consumes. -->
  <link name="caster_link">
    <visual><geometry><sphere radius="${caster_radius}"/></geometry><material name="wheel"/></visual>
    <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- COIN-D6, above the caster. The unit is mounted with its own zero facing
       the caster end, i.e. along base_link +x, so no yaw offset is needed here.
       If a wall straight ahead does not appear at angle zero in /scan, correct
       the yaw in this joint's rpy rather than in the driver. -->
  <link name="laser">
    <visual><geometry><cylinder radius="0.035" length="0.035"/></geometry><material name="sensor"/></visual>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="${caster_x} 0 ${laser_height - wheel_radius}" rpy="0 0 0"/></joint>

  <!-- MPU9250/9255/6500. Frame of the /imu/data message. The chip is bolted
       down facing the axle end, which is the rear, so imu_link really is yawed
       180 deg from base_link and this joint says so. That is a fact about the
       hardware, not a correction: the firmware publishes accelerometer and
       gyro readings in the chip's own axes and TF rotates them, which is what
       frames are for.
       Yaw is the exception and needs no rotation anywhere: a 180 deg yaw
       leaves the z axis alone, so a counter-clockwise turn is counter-
       clockwise in both frames. That is why odometry heading can come straight
       from this chip while +x points the other way. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 ${base_height}" rpy="0 0 ${pi}"/></joint>
</robot>
